[Unit]
Description=Edward Growth System API
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=edward
WorkingDirectory=/opt/edward-growth/backend
Environment="PATH=/opt/edward-growth/backend/venv/bin"
ExecStart=/opt/edward-growth/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
